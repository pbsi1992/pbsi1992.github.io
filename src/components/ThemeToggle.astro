---
import { Moon, Sun } from "lucide-astro";
---

<button
  id="theme-toggle"
  class="group relative p-2.5 rounded-xl border border-site-border bg-site-bg hover:border-primary/40 transition-all flex items-center justify-center shadow-sm overflow-hidden active:scale-95"
  aria-label="Toggle Theme"
>
  <!-- Moon: Visible in Light Mode -->
  <Moon
    class="w-5 h-5 block dark:hidden text-primary transition-all duration-500 group-hover:rotate-12 group-hover:scale-110"
    stroke-width={2}
  />

  <!-- Sun: Visible in Dark Mode -->
  <Sun
    class="w-5 h-5 hidden dark:block text-primary transition-all duration-500 group-hover:rotate-45 group-hover:scale-110"
    stroke-width={2}
  />

  <div
    class="absolute inset-0 pointer-events-none bg-primary/0 group-hover:bg-primary/5 transition-colors duration-300"
  ></div>
</button>

<script is:inline>
  function applyTheme() {
    const localStorageTheme = localStorage.getItem("theme");

    if (localStorageTheme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
  }

  function setupThemeToggle() {
    const toggleBtn = document.getElementById("theme-toggle");

    if (!toggleBtn) return;

    const newBtn = toggleBtn.cloneNode(true);
    toggleBtn.replaceWith(newBtn);

    newBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");

      localStorage.setItem(
        "theme",
        isDark ? "dark" : "light"
      );
    });
  }

  applyTheme();
  setupThemeToggle();

  document.addEventListener("astro:after-swap", () => {
    applyTheme();
    setupThemeToggle();
  });
</script>